{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TunePeerly",
  "mainBinaryName": "TunePeerly",
  "version": "0.8.0-alpha.1",
  "identifier": "com.zhebuilds.tunepeerly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": {
      "localData": "$LOCALDATA/TunePeerly",
      "cache": "$CACHE/TunePeerly"
    },
    "windows": [
      {
        "label": "main",
        "title": "TunePeerly",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost http://127.0.0.1:*",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPCACHE/covers/**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "zhebuilds",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
